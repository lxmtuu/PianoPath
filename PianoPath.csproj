<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PianoPath</RootNamespace>
    <ApplicationIcon>Assets/Keyflow.ico</ApplicationIcon>
    <Product>Keyflow · Piano VFX Studio</Product>
    <Authors>Yami, Neyu</Authors>
    <Copyright>© 2026 Yami · Neyu. Contributor: Jin.</Copyright>
    <Description>Piano practice and visualizer for Windows: MIDI playback with the Salamander Grand SFZ piano and a concert-themed piano-roll stage.</Description>
    <!-- The one place the release number is written down in code: AppInfo.Version reads it back out of
         the stamped assembly for the start-up menu, the About box and the perf gate's report, and
         tools/check_sources.py (scan_release_version) pins every mirror of it — the installer fallback,
         both README examples, both CHANGELOGs — to this value. (An XML comment may not contain a double
         hyphen, which is why this one says "the perf gate" instead of naming its switch.) -->
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project is a sibling, not a dependency: it links the sources it needs. Without this the
         default glob would compile tests/ into the application as well, where xUnit does not exist. -->
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The community preset shelf: the files in presets/ ship inside the application, read by
         Stage/CommunityPresets.cs. tools/make_presets.py writes them; tools/check_sources.py checks them. -->
    <EmbeddedResource Include="presets/*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GPU stage (Gpu/): Direct3D 11 through Vortice.Windows. The shaders are compiled at start-up
         with the system's d3dcompiler_47.dll, which every supported Windows version ships. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <EmbeddedResource Include="Gpu/StageShaders.hlsl" LogicalName="PianoPath.Gpu.StageShaders.hlsl" />
    <EmbeddedResource Include="Ui/GalaxyBackdrop.hlsl" LogicalName="PianoPath.Ui.GalaxyBackdrop.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <!-- The supplied Keyflow artwork is used by WPF surfaces and compiled into every Windows executable icon size. -->
    <Resource Include="Assets/KeyflowLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app downloads Salamander samples to the user's data directory on request; no piano sample bank
         is embedded in the executable or copied with a release. The MIT license still travels with builds. -->
    <None Remove="LICENSE" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" TargetPath="LICENSE.txt" />
  </ItemGroup>

</Project>
