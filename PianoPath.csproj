<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PianoPath</RootNamespace>
    <Product>Keyflow · Piano VFX Studio</Product>
    <Authors>Yami, Neyu</Authors>
    <Copyright>© 2026 Yami · Neyu. Contributor: Jin.</Copyright>
    <Description>Piano practice and visualizer for Windows: MIDI playback, SoundFont synthesis and a concert-themed piano-roll stage.</Description>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project is a sibling, not a dependency: it links the sources it needs. Without this the
         default glob would compile tests/ into the application as well, where xUnit does not exist. -->
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The community preset shelf: the files in presets/ ship inside the application, read by
         Stage/CommunityPresets.cs. tools/make_presets.py writes them; tools/check_sources.py checks them. -->
    <EmbeddedResource Include="presets/*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GPU stage (Gpu/): Direct3D 11 through Vortice.Windows. The shaders are compiled at start-up
         with the system's d3dcompiler_47.dll, which every supported Windows version ships. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <EmbeddedResource Include="Gpu/StageShaders.hlsl" LogicalName="PianoPath.Gpu.StageShaders.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ConcertGrand.sf2" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ATTRIBUTION.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
