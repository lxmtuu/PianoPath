@@ -0,0 +1,56 @@
+name: release
+
+# Builds distributable .exe packages. Runs when a version tag such as v0.3.0 is pushed
+# (the zips are attached to a GitHub Release) or manually from the Actions tab
+# (the zips are available as workflow artifacts).
+on:
+  push:
+    tags: ["v*"]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  publish:
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          # A release must ship the real SoundFont, so download the ~113 MiB LFS object (counts against the LFS bandwidth quota).
+          lfs: true
+
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: 10.0.x
+
+      - name: Publish self-contained single file (win-x64)
+        shell: pwsh
+        run: .\publish.ps1 -Mode SelfContained -Runtime win-x64 -Zip
+
+      - name: Publish framework-dependent single file (win-x64)
+        shell: pwsh
+        run: .\publish.ps1 -Mode FrameworkDependent -Runtime win-x64 -Zip
+
+      - name: Smoke test the published executable
+        continue-on-error: true
+        shell: pwsh
+        run: |
+          $log = Join-Path $env:RUNNER_TEMP 'keyflow-verification.log'
+          $proc = Start-Process -FilePath 'publish/win-x64/PianoPath.exe' -ArgumentList "--verify","--verify-log=$log" -PassThru -Wait
+          if (Test-Path $log) { Get-Content $log }
+          exit $proc.ExitCode
+
+      - name: Upload workflow artifacts
+        uses: actions/upload-artifact@v4
+        with:
+          name: Keyflow-win-x64
+          path: publish/*.zip
+          if-no-files-found: error
+
+      - name: Attach packages to the GitHub Release
+        if: startsWith(github.ref, 'refs/tags/v')
+        uses: softprops/action-gh-release@v2
+        with:
+          files: publish/*.zip
+          generate_release_notes: true
