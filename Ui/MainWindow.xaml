            <TextBlock x:Name="MainMenuCopyrightLabel" Text="© 2026 Yami · Neyu — Contributor: Jin" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}" FontSize="9.5" Opacity=".85" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34,0,0,26"/>
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="96,0,40,0">
