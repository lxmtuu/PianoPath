<Window x:Class="PianoPath.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PianoPath"
        Title="Keyflow — Piano VFX" Height="920" Width="1600" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" WindowStyle="None" ResizeMode="NoResize"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowState="Maximized"
        PreviewKeyDown="Window_KeyDown" KeyUp="Window_KeyUp" MouseMove="Window_MouseMove" Deactivated="Window_Deactivated" Closed="Window_Closed">
    <Window.Resources>
        <DropShadowEffect x:Key="DockShadow" Color="#000000" BlurRadius="38" ShadowDepth="0" Opacity=".62"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="FooterRow" Height="94"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border x:Name="HeaderChrome" Grid.Row="0" Margin="22,12,22,0" Padding="14,8" Style="{StaticResource PanelChromeStyle}" Panel.ZIndex="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,16,0">
                    <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource AccentGradientBrush}" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <Path Data="{StaticResource IconLogo}" Fill="White" Width="21" Height="21" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KEYFLOW" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="PIANO VFX STUDIO" Style="{StaticResource EyebrowTextStyle}" FontSize="8" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="34" Background="{DynamicResource PanelBorderBrush}" Margin="18,0,16,0"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="380">
                        <TextBlock x:Name="SongTitle" Text="Live Piano" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowPlayingLabel" Text="LIVE PLAY · PRESS A KEY" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="10" Background="#0E1017" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LOOK" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="HeaderPresetLabel" Text="Neon Violet" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Change" Style="{StaticResource GhostButtonStyle}" Padding="8,2" Margin="8,0,0,0" FontSize="10" Click="StyleQuick_Click" ToolTip="Open the style presets"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconHome}" Click="MainMenu_Click" ToolTip="Back to the main menu" Margin="0,0,6,0"/>
                    <Button Content="OPEN MIDI" Tag="{StaticResource IconFolder}" Style="{StaticResource AccentIconButtonStyle}" Click="OpenMidi_Click" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="SETTINGS" Tag="{StaticResource IconSliders}" Style="{StaticResource IconTextButtonStyle}" Click="Settings_Click" Margin="0,0,12,0" Padding="14,8" ToolTip="Show or hide the settings dock (Escape)"/>
                    <Border Width="1" Height="30" Background="{DynamicResource PanelBorderBrush}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconMinimize}" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconMaximize}" Click="FullScreen_Click" Margin="2,0" ToolTip="Toggle full screen (F11)"/>
                    <Button Style="{StaticResource CaptionCloseStyle}" Tag="{StaticResource IconClose}" Click="CloseWindow_Click" Margin="2,0,0,0" ToolTip="Exit Keyflow"/>
                </StackPanel>
                <!-- Animated accent sweep: a slow comet of colour travelling along the header edge. -->
                <Border x:Name="HeaderSweep" Grid.ColumnSpan="3" Style="{StaticResource SweepLineStyle}" VerticalAlignment="Bottom" Margin="2,0,2,-9" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ===================== STAGE ===================== -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <local:PianoStage x:Name="Stage" PianoKeyChanged="Stage_PianoKeyChanged"/>

            <!-- Settings dock: full height, docked to the right, category navigation on the left. -->
            <Border x:Name="SettingsPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="672" Margin="0,8,0,8" Background="{DynamicResource PanelBrush}" CornerRadius="18,0,0,18" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,0,1" Effect="{StaticResource DockShadow}" Panel.ZIndex="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Animated theme haze behind the dock content: first child, so it stays behind every control. -->
                    <local:ChromeBackdrop x:Name="DockBackdrop" Grid.Row="0" Grid.RowSpan="3" Margin="1,1,0,1" Opacity=".45" IsHitTestVisible="False"/>
                    <Border Grid.Row="0" Padding="18,14,14,12" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SETTINGS" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PresetNameLabel" Text="Preset · Neon Violet" Style="{StaticResource MutedTextStyle}" FontSize="9.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center" MaxWidth="268" HorizontalAlignment="Stretch">
                                <TextBox x:Name="SettingsSearchBox" Height="32" Style="{StaticResource SearchBoxStyle}" TextChanged="SettingsSearch_TextChanged" ToolTip="Filter the settings on every page"/>
                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SettingsSearchHint" Text="Search settings" Foreground="{StaticResource DimTextBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconClose}" Click="Settings_Click" Margin="12,0,0,0" ToolTip="Close (Escape)"/>
                        </Grid>
                    </Border>

                    <TabControl x:Name="SettingsTabs" Grid.Row="1" Style="{StaticResource SettingsTabControlStyle}" ItemContainerStyle="{StaticResource SettingsNavItemStyle}" SelectedIndex="0" SelectionChanged="SettingsTabs_SelectionChanged">
                        <TabItem Header="Style" Tag="{StaticResource IconStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="PRESETS" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="Pick a complete look, then fine-tune it on the other pages. Save your own presets to reuse or share them." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"/>
                                    <ListBox x:Name="PresetList" Style="{StaticResource PresetListStyle}" SelectionChanged="PresetList_SelectionChanged" MouseDoubleClick="PresetList_MouseDoubleClick" MaxHeight="420"/>
                                    <TextBlock x:Name="PresetDescriptionLabel" Style="{StaticResource MutedTextStyle}" Margin="2,4,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="ApplyPresetButton" Content="APPLY PRESET" Style="{StaticResource AccentButtonStyle}" Click="ApplyPreset_Click" Margin="0,0,8,8"/>
                                        <Button Content="SAVE AS…" Click="SavePresetAs_Click" Margin="0,0,8,8" ToolTip="Store the current look as a user preset"/>
                                        <Button x:Name="DeletePresetButton" Content="DELETE" Style="{StaticResource DangerButtonStyle}" Click="DeletePreset_Click" Margin="0,0,8,8" IsEnabled="False"/>
                                        <Button Content="IMPORT…" Click="ImportPreset_Click" Margin="0,0,8,8" ToolTip="Load a preset .json file"/>
                                        <Button Content="EXPORT…" Click="ExportPreset_Click" Margin="0,0,8,8" ToolTip="Save the current look as a .json file"/>
                                        <Button Content="RESET TO DEFAULT" Style="{StaticResource GhostButtonStyle}" Click="ResetVisualSettings_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <StackPanel x:Name="StyleSettingsHost"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Theme" Tag="{StaticResource IconTheme}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ThemeSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Notes" Tag="{StaticResource IconNotes}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NoteSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Particles" Tag="{StaticResource IconParticles}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParticleSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Keyboard" Tag="{StaticResource IconKeyboard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="KeyboardSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Background" Tag="{StaticResource IconBackground}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SceneSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Camera &amp; FX" Tag="{StaticResource IconCamera}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CameraSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Audio" Tag="{StaticResource IconAudio}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="INSTRUMENT" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="Keyflow plays through a SoundFont (.sf2). The bundled concert grand loads automatically; load another file to change the sound." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,12"/>
                                    <Border Padding="14" CornerRadius="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="SoundFontLabel" Text="BUILT-IN GRAND · STARTING" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SoundFontHint" Text="Yamaha Disklavier grand piano" Style="{StaticResource MutedTextStyle}" FontSize="9.5" Margin="0,3,0,12"/>
                                            <WrapPanel>
                                                <Button x:Name="SoundFontButton" Content="◉  LOAD SOUNDFONT" Style="{StaticResource AccentButtonStyle}" Click="LoadSoundFont_Click" Margin="0,0,8,0"/>
                                                <Button Content="Unload · silent mode" Click="UnloadSoundFont_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="PRESET" Style="{StaticResource SectionTitleStyle}"/>
                                    <ComboBox x:Name="PresetCombo" IsEnabled="False" SelectionChanged="PresetCombo_SelectionChanged" ToolTip="Choose an instrument preset from the loaded SoundFont"/>
                                    <TextBlock Text="EFFECTS" Style="{StaticResource SectionTitleStyle}"/>
                                    <ToggleButton x:Name="ReverbToggle" Content="HALL REVERB" HorizontalAlignment="Left" Height="32" Style="{StaticResource PedalToggleStyle}" IsChecked="True" Checked="ReverbToggle_Changed" Unchecked="ReverbToggle_Changed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="MIDI" Tag="{StaticResource IconMidi}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="DEVICES" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="MIDI input" Style="{StaticResource LabelTextStyle}" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="InputDeviceCombo" SelectionChanged="InputDeviceCombo_SelectionChanged"/>
                                    <TextBlock Text="MIDI output" Style="{StaticResource LabelTextStyle}" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="OutputDeviceCombo" SelectionChanged="OutputDeviceCombo_SelectionChanged"/>
                                    <Button Content="⟳  Refresh devices" Click="RefreshDevices_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    <TextBlock Text="SONG TRACKS" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,4"/>
                                    <TextBlock Text="Solo a single track for practice, or mute tracks and recolor them for the video." Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="TrackCombo" SelectionChanged="TrackCombo_SelectionChanged"><ComboBoxItem Content="All notes"/></ComboBox>
                                    <StackPanel x:Name="TrackListHost" Margin="0,10,0,0"/>
                                    <TextBlock Text="METRONOME" Style="{StaticResource SectionTitleStyle}"/>
                                    <CheckBox x:Name="MetronomeCheck" Content="SoundFont metronome click" IsEnabled="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Practice" Tag="{StaticResource IconPractice}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="PRACTICE MODE" Style="{StaticResource EyebrowTextStyle}"/>
                                    <ComboBox x:Name="ModeCombo" SelectedIndex="0" Margin="0,8,0,0" SelectionChanged="ModeCombo_SelectionChanged"><ComboBoxItem Content="Follow along"/><ComboBoxItem Content="Wait for my note"/><ComboBoxItem Content="Right hand only"/><ComboBoxItem Content="Left hand only"/></ComboBox>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Playback tempo" Style="{StaticResource LabelTextStyle}"/>
                                        <TextBlock x:Name="TempoLabel" Grid.Column="1" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="TempoSlider" Minimum="50" Maximum="150" Value="100" ValueChanged="TempoSlider_ValueChanged"/>
                                    <TextBlock Text="LOOP RANGE" Style="{StaticResource SectionTitleStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="A" Click="SetLoopA_Click" Width="40" ToolTip="Set the loop start at the playhead"/>
                                        <Button Content="B" Click="SetLoopB_Click" Width="40" Margin="6,0,0,0" ToolTip="Set the loop end at the playhead"/>
                                        <Button Content="×" Click="ClearLoop_Click" Width="40" Margin="6,0,0,0" ToolTip="Clear the loop"/>
                                        <TextBlock x:Name="LoopLabel" Text="No loop" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Keys A W S E D F T G Y H U J K play an octave from C3 · Space play/pause · Escape settings · F11 full screen · click the on-screen keyboard to play with the mouse."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Recording" Tag="{StaticResource IconRecord}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="VIDEO CAPTURE" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="Records the stage to an AVI file (MJPEG when a codec is available). Use the Green Screen preset and OBS for a keyed overlay." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"/>
                                    <StackPanel x:Name="RecordingSettingsHost"/>
                                    <TextBlock x:Name="RecordingInfoLabel" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,10"/>
                                    <Button Content="●  START / STOP RECORDING" Style="{StaticResource DangerButtonStyle}" Click="RecordVideo_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2" Padding="18,10" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsSaveLabel" Text="Changes apply live · saved automatically" Style="{StaticResource MutedTextStyle}" FontSize="9.5" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="RESET PAGE" Style="{StaticResource GhostButtonStyle}" Click="ResetPage_Click" Margin="0,0,6,0" ToolTip="Restore the current page to the active preset"/>
                                <Button Content="SAVE" Style="{StaticResource AccentButtonStyle}" Click="SaveVisualSettings_Click" Padding="16,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="LiveChromeOverlay" Panel.ZIndex="5" IsHitTestVisible="True">
                <Button x:Name="RecordButton" Content="REC" Tag="{StaticResource IconRecord}" Style="{StaticResource DangerIconButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,18,0,0" Padding="15,10" Click="RecordVideo_Click" ToolTip="Record the live piano visualizer"/>
                <Button x:Name="LiveSettingsButton" Content="MENU" Tag="{StaticResource IconMenu}" Style="{StaticResource IconTextButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,26,0" Padding="16,10" Click="Settings_Click" ToolTip="Show visual, audio, MIDI and practice settings (Escape)"/>
            </Grid>
            <Border x:Name="DeviceStatusBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,72,0,0" Padding="10,7" CornerRadius="10" Background="#C90A0B11" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="3">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DeviceDot" Width="6" Height="6" Fill="#FFB45B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DeviceLabel" Text="Computer keyboard ready" Foreground="#B9BFCE" FontSize="9.5" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  A0—C8" Foreground="{StaticResource DimTextBrush}" FontSize="9.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== FOOTER / TRANSPORT ===================== -->
        <Border x:Name="FooterChrome" Grid.Row="2" Margin="22,0,22,12" Padding="14,8" Style="{StaticResource PanelChromeStyle}" Panel.ZIndex="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Style="{StaticResource TransportPlayStyle}" Tag="{StaticResource IconPlay}" Click="Play_Click" IsEnabled="False" ToolTip="Open a MIDI file to start playback (Space)"/>
                        <Button x:Name="RestartButton" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconRestart}" Width="38" Height="38" Click="Restart_Click" Margin="8,0,0,0" IsEnabled="False" ToolTip="Back to the start"/>
                        <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI"/>
                            <TextBlock x:Name="NoteNameLabel" Text="READY" Foreground="{DynamicResource Accent2Brush}" FontSize="9" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="PEDALS" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ToggleButton x:Name="SoftPedalToggle" Content="SOFT" Height="30" Margin="2,0" Style="{StaticResource PedalToggleStyle}" ToolTip="Left pedal · Una corda · MIDI CC 67" Checked="PedalToggle_Changed" Unchecked="PedalToggle_Changed"/>
                        <ToggleButton x:Name="SostenutoPedalToggle" Content="SOSTENUTO" Height="30" Margin="2,0" Style="{StaticResource PedalToggleStyle}" ToolTip="Middle pedal · Sostenuto · MIDI CC 66" Checked="PedalToggle_Changed" Unchecked="PedalToggle_Changed"/>
                        <ToggleButton x:Name="SustainPedalToggle" Content="SUSTAIN" Height="30" Margin="2,0" Style="{StaticResource PedalToggleStyle}" ToolTip="Right pedal · Damper/Sustain · MIDI CC 64" Checked="PedalToggle_Changed" Unchecked="PedalToggle_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatChipStyle}">
                            <StackPanel>
                                <TextBlock Text="ACCURACY" Style="{StaticResource EyebrowTextStyle}"/>
                                <TextBlock x:Name="AccuracyLabel" Text="—" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatChipStyle}">
                            <StackPanel>
                                <TextBlock Text="SCORE" Style="{StaticResource EyebrowTextStyle}"/>
                                <TextBlock x:Name="ScoreLabel" Text="0 hits · 0 missed" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatChipStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="STREAK" Style="{StaticResource EyebrowTextStyle}"/>
                                <TextBlock x:Name="StreakLabel" Text="✦ 0 streak" Foreground="{StaticResource SuccessBrush}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Border x:Name="FooterSweep" Style="{StaticResource SweepLineStyle}" VerticalAlignment="Top" Margin="2,-9,2,0" IsHitTestVisible="False"/>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" IsMoveToPointEnabled="True" IsEnabled="False" PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" ValueChanged="SeekSlider_ValueChanged"/>
                    <ProgressBar x:Name="ProgressBar" Height="2" Maximum="100" Value="0" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity=".7"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== PLAY DIALOG (Embers-style pre-flight) ===================== -->
        <Grid x:Name="PlayDialogOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="28" Background="#A8040509">
            <Border x:Name="PlayDialogCard" Width="660" MaxHeight="820" VerticalAlignment="Center" Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Effect="{StaticResource DockShadow}">
                <Grid Margin="28,22,28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Play" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource RoundGlyphButtonStyle}" Tag="{StaticResource IconClose}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="PlayDialogClose_Click" ToolTip="Close"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="PlayDialogMidiButton" Content="MIDI File" Tag="{StaticResource IconFolder}" Style="{StaticResource IconTextButtonStyle}" Click="PlayDialogOpenMidi_Click" Padding="16,9" ToolTip="Choose a Standard MIDI file"/>
                                <Button Grid.Column="2" Content="Live Play" Style="{StaticResource GhostButtonStyle}" Click="PlayDialogLive_Click" Padding="12,8" FontSize="12" ToolTip="Skip playback and perform live right away"/>
                            </Grid>
                            <TextBlock Text="STYLES" Style="{StaticResource EyebrowTextStyle}" Margin="0,20,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="LeftStyleCard" CornerRadius="12" BorderThickness="2" Background="#10131B" Margin="0,0,6,0" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="PlayDialogStyleCard_Click" Tag="0" ToolTip="Open the Notes page to design this hand">
                                    <StackPanel>
                                        <TextBlock Text="Left Hand" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="LeftStyleLabel" Text="Neon Violet" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" x:Name="RightStyleCard" CornerRadius="12" BorderThickness="2" Background="#10131B" Margin="6,0,0,0" Padding="14,10" Cursor="Hand" MouseLeftButtonUp="PlayDialogStyleCard_Click" Tag="1" ToolTip="Open the Notes page to design this hand">
                                    <StackPanel>
                                        <TextBlock Text="Right Hand" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock x:Name="RightStyleLabel" Text="Neon Violet" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="OPTIONS" Style="{StaticResource EyebrowTextStyle}" Margin="0,20,0,2"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Path Data="{StaticResource IconNotes}" Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="Speed" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlaySpeedLabel" Grid.Column="2" Text="550" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="↺" Style="{StaticResource MiniButtonStyle}" Click="PlaySpeedReset_Click" ToolTip="Reset fall speed"/>
                                <Slider Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" x:Name="PlaySpeedSlider" Minimum="100" Maximum="1000" Value="550" Margin="0,6,0,0" ValueChanged="PlaySpeed_Changed"/>
                            </Grid>
                            <StackPanel x:Name="LayerRowsHost" Margin="0,10,0,0">
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" x:Name="PlayDialogThemeOrb" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Theme" Click="PlayDialogExpand_Click" ToolTip="Interface theme, motion and ambient motes"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Camera" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Camera" Click="PlayDialogExpand_Click" ToolTip="Parallax, zoom, saturation, bloom"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Background" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" x:Name="LayerBackgroundToggle" Tag="ShowBackground" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Background" Click="PlayDialogExpand_Click" ToolTip="Image, dim, guide lanes, gradient"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Notes" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" x:Name="LayerNotesToggle" Tag="ShowNotes" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Notes" Click="PlayDialogExpand_Click" ToolTip="Note style, colors, glow, edge"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Embers" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" x:Name="LayerEmbersToggle" Tag="ShowEmbers" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Embers" Click="PlayDialogExpand_Click" ToolTip="Sparks, wisps, particle physics"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Halo" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="PlayDialogHaloColorButton" Width="22" Height="22" Margin="0,0,8,0" Style="{StaticResource MiniButtonStyle}" Padding="0" Click="PlayDialogHaloColor_Click" ToolTip="Choose halo glow color">
                                        <Border x:Name="PlayDialogHaloColorDot" Width="14" Height="14" CornerRadius="7" Background="#C66EFF"/>
                                    </Button>
                                    <CheckBox Grid.Column="2" x:Name="LayerHaloToggle" Tag="ShowHalo" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Halo" Click="PlayDialogExpand_Click" ToolTip="The burning impact line above the keys"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Flame" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" x:Name="LayerFlameToggle" Tag="ShowFlame" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Flame" Click="PlayDialogExpand_Click" ToolTip="Flame tongues rising from the key bed"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keys" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" x:Name="LayerKeysToggle" Tag="ShowKeys" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" DataContext="Keys" Click="PlayDialogExpand_Click" ToolTip="Keyboard style, lighting, overhang, ray-traced shading"/>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Extras" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource GlyphButtonStyle}" Tag="{StaticResource IconChevronDown}" Width="26" Height="26" Click="PlayDialogExtras_Click" ToolTip="Counter and watermark"/>
                                </Grid>
                                <StackPanel x:Name="ExtrasSubPanel" Visibility="Collapsed" Margin="18,0,0,0">
                                    <CheckBox Content="Counter" Tag="ShowCounter" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" Margin="0,3,0,3"/>
                                    <CheckBox Content="Watermark" Tag="ShowWatermark" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed" Margin="0,3,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Margin="0,18,0,0" Height="58" Style="{StaticResource AccentButtonStyle}" FontSize="19" Click="PlayDialogPlay_Click" ToolTip="Start playback (Space)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPlay}" Fill="White" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Play" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== MAIN MENU (concert shell) =====================
             The opening screen is the concert itself: an animated acoustic chamber backdrop,
             the Steinway concert grand brand, primary performance actions, a live theme picker and a
             read-out of the stage look. Every animation is driven by the shared frame clock. -->
        <Grid x:Name="MainMenuOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="30">
            <local:ChromeBackdrop x:Name="MenuBackdrop"/>
            <Border Background="{StaticResource ConcertVeilBrush}"/>
            <TextBlock x:Name="MainMenuVersionLabel" Text="Keyflow 0.4 · Concert Grand Edition" Style="{StaticResource EyebrowTextStyle}" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34,0,0,26"/>
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="96,0,40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MenuActionStack" Width="388" VerticalAlignment="Center">
                    <StackPanel x:Name="MenuBrand" Orientation="Horizontal" Margin="8,0,0,26">
                        <Border Width="62" Height="62" CornerRadius="18" Background="{DynamicResource AccentGradientBrush}" BorderBrush="#55FFFFFF" BorderThickness="1.5">
                            <Path Data="{StaticResource IconLogo}" Fill="White" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Keyflow" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="5" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="CONCERT GRAND" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                                <Path Data="{StaticResource IconSparkle}" Fill="{DynamicResource AccentBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="PIANO PERFORMANCE &amp; VFX STUDIO" Style="{StaticResource EyebrowTextStyle}" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="MenuPlayButton" Content="Perform &amp; Play" Style="{StaticResource MenuPrimaryButtonStyle}" Click="MainMenuPlay_Click" ToolTip="Open a MIDI score or perform live on the concert stage (Space)"/>
                    <Button x:Name="MenuDesignButton" Content="Stage Design Studio" Style="{StaticResource MenuCardButtonStyle}" Margin="0,12,0,0" Click="MainMenuDesign_Click" ToolTip="Fine-tune visual effects, ray-traced keyboard shading and colors"/>
                    <StackPanel x:Name="MenuLinkStack" Margin="10,22,0,0">
                        <Button Content="Audio &amp; MIDI Hardware Setup" Style="{StaticResource MenuLinkButtonStyle}" Click="MainMenuSettings_Click" ToolTip="Disklavier SoundFonts, MIDI routing and latency settings"/>
                        <Button Content="About Keyflow Concert Grand" Style="{StaticResource MenuLinkButtonStyle}" Click="MainMenuAbout_Click"/>
                        <Button Content="Exit Keyflow" Style="{StaticResource MenuLinkButtonStyle}" Click="MainMenuExit_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="MenuSidePanel" Grid.Column="2" Width="368" VerticalAlignment="Center" Margin="64,0,0,0">
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTheme}" Fill="{DynamicResource Accent2Brush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CONCERT THEME PALETTE" Style="{StaticResource EyebrowTextStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="MenuThemeBlurb" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                            <StackPanel x:Name="MenuThemeHost" Margin="0,2,0,0"/>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,6,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMotion}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ACTIVE STAGE LOOK" Style="{StaticResource EyebrowTextStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="MenuPresetLabel" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="OPEN DESIGN" Style="{StaticResource AccentButtonStyle}" Click="MainMenuDesign_Click" Margin="0,0,8,0" ToolTip="Every stage setting lives in the design dock"/>
                                <Button Content="TRY A LOOK" Click="MenuPresetShuffle_Click" ToolTip="Cycle through the built-in stage presets"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MenuQuoteText" Style="{StaticResource MenuQuoteStyle}" Margin="10,20,0,0" Text="The piano keys are black and white, but they sound like a million colors in your mind."/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
