             The shell hides every toolbar after a few idle seconds, so the shortcuts are documented
             inside the application instead of only in the README. The three columns are generated in
             MainWindow.Shortcuts.cs; F1 toggles this card and Escape closes it. -->
        <Grid x:Name="ShortcutOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="32" Background="#A8040509" MouseLeftButtonDown="ShortcutOverlay_Click">
            <Border x:Name="ShortcutCard" Width="944" VerticalAlignment="Center" Background="{DynamicResource PanelBrush}" CornerRadius="18" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Effect="{StaticResource DockShadow}" MouseLeftButtonDown="ShortcutCard_Click">
