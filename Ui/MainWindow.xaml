                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTheme}" Fill="{DynamicResource Accent2Brush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CONCERT THEME PALETTE" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="MenuThemeBlurb" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                            <StackPanel x:Name="MenuThemeHost" Margin="0,2,0,0"/>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,6,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMotion}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ACTIVE STAGE LOOK" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="MenuPresetLabel" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="OPEN DESIGN" Style="{StaticResource AccentButtonStyle}" Click="MainMenuDesign_Click" Margin="0,0,8,0" ToolTip="Every stage setting lives in the design dock" local:Loc.Localize="True"/>
                                <Button Content="TRY A LOOK" Click="MenuPresetShuffle_Click" ToolTip="Cycle through the built-in stage presets" local:Loc.Localize="True"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource Accent2Brush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="INTERFACE LANGUAGE" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,8" TextWrapping="Wrap" Text="Every menu, dock page and dialog follows this choice — no restart, and nothing you saved changes." local:Loc.Localize="True"/>
                            <WrapPanel x:Name="MenuLanguageHost"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MenuQuoteText" Style="{StaticResource MenuQuoteStyle}" Margin="10,20,0,0" Text="The piano keys are black and white, but they sound like a million colors in your mind." local:Loc.Localize="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
