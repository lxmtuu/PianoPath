<Window x:Class="PianoPath.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PianoPath"
        Title="Keyflow — Piano VFX" local:Loc.Localize="True" Height="920" Width="1600" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" WindowStyle="None" ResizeMode="NoResize"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowState="Maximized"
        PreviewKeyDown="Window_KeyDown" KeyUp="Window_KeyUp" MouseMove="Window_MouseMove" Deactivated="Window_Deactivated" Closed="Window_Closed" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <DropShadowEffect x:Key="DockShadow" Color="#000000" BlurRadius="38" ShadowDepth="0" Opacity=".62"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="FooterRow" Height="94"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border x:Name="HeaderChrome" Grid.Row="0" Margin="22,12,22,0" Padding="14,8" Style="{StaticResource PanelChromeStyle}" Panel.ZIndex="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,16,0">
                    <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource AccentGradientBrush}" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <Path Data="{StaticResource IconLogo}" Fill="White" Width="21" Height="21" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KEYFLOW" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="PIANO VFX STUDIO" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}" FontSize="8" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="34" Background="{DynamicResource PanelBorderBrush}" Margin="18,0,16,0"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="380">
                        <TextBlock x:Name="SongTitle" Text="Live Piano" local:Loc.Localize="True" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowPlayingLabel" Text="LIVE PLAY · PRESS A KEY" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="10" Background="#0E1017" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LOOK" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="HeaderPresetLabel" Text="Neon Violet" local:Loc.Localize="True" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Change" Style="{StaticResource GhostButtonStyle}" Padding="8,2" Margin="8,0,0,0" FontSize="10" Click="StyleQuick_Click" ToolTip="Open the style presets" local:Loc.Localize="True"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconHome}" Click="MainMenu_Click" ToolTip="Back to the main menu" local:Loc.Localize="True" Margin="0,0,6,0"/>
                    <Button Content="OPEN MIDI" local:Loc.Localize="True" Tag="{StaticResource IconFolder}" Style="{StaticResource AccentIconButtonStyle}" Click="OpenMidi_Click" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="SETTINGS" Tag="{StaticResource IconSliders}" Style="{StaticResource IconTextButtonStyle}" Click="Settings_Click" Margin="0,0,12,0" Padding="14,8" ToolTip="Show or hide the settings dock (Escape)" local:Loc.Localize="True"/>
                    <Border Width="1" Height="30" Background="{DynamicResource PanelBorderBrush}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconMinimize}" Click="Minimize_Click" ToolTip="Minimize" local:Loc.Localize="True"/>
                    <Button Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconMaximize}" Click="FullScreen_Click" Margin="2,0" ToolTip="Toggle full screen (F11)" local:Loc.Localize="True"/>
                    <Button Style="{StaticResource CaptionCloseStyle}" Tag="{StaticResource IconClose}" Click="CloseWindow_Click" Margin="2,0,0,0" ToolTip="Exit Keyflow" local:Loc.Localize="True"/>
                </StackPanel>
                <!-- Animated accent sweep: a slow comet of colour travelling along the header edge. -->
                <Border x:Name="HeaderSweep" Grid.ColumnSpan="3" Style="{StaticResource SweepLineStyle}" VerticalAlignment="Bottom" Margin="2,0,2,-9" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ===================== STAGE ===================== -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <local:PianoStage x:Name="Stage" PianoKeyChanged="Stage_PianoKeyChanged"/>

            <!-- Settings dock: full height, docked to the right, category navigation on the left. -->
            <Border x:Name="SettingsPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="672" Margin="0,8,0,8" KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource PanelBrush}" CornerRadius="18,0,0,18" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,1,0,1" Effect="{StaticResource DockShadow}" Panel.ZIndex="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Animated theme haze behind the dock content: first child, so it stays behind every control. -->
                    <local:ChromeBackdrop x:Name="DockBackdrop" Grid.Row="0" Grid.RowSpan="3" Margin="1,1,0,1" Opacity=".45" IsHitTestVisible="False"/>
                    <Border Grid.Row="0" Padding="18,14,14,12" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SETTINGS" local:Loc.Localize="True" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PresetNameLabel" Text="Preset · Neon Violet" local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" FontSize="9.5" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center" MaxWidth="268" HorizontalAlignment="Stretch">
                                <TextBox x:Name="SettingsSearchBox" Height="32" Style="{StaticResource SearchBoxStyle}" TextChanged="SettingsSearch_TextChanged" ToolTip="Filter the settings on every page" local:Loc.Localize="True"/>
                                <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SettingsSearchHint" Text="Search settings" local:Loc.Localize="True" Foreground="{StaticResource DimTextBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource CaptionButtonStyle}" Tag="{StaticResource IconClose}" Click="Settings_Click" Margin="12,0,0,0" ToolTip="Close (Escape)" local:Loc.Localize="True"/>
                        </Grid>
                    </Border>

                    <TabControl x:Name="SettingsTabs" Grid.Row="1" Style="{StaticResource SettingsTabControlStyle}" ItemContainerStyle="{StaticResource SettingsNavItemStyle}" SelectedIndex="0" SelectionChanged="SettingsTabs_SelectionChanged">
                        <TabItem Header="Style" local:Loc.Localize="True" Tag="{StaticResource IconStyle}" local:SettingsPages.Section="STAGE DESIGN">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="PRESETS" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="Pick a complete look, then fine-tune it on the other pages. Save your own presets to reuse or share them." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"/>
                                    <ListBox x:Name="PresetList" AutomationProperties.Name="Stage presets" local:Loc.Localize="True" Style="{StaticResource PresetListStyle}" SelectionChanged="PresetList_SelectionChanged" MouseDoubleClick="PresetList_MouseDoubleClick" MaxHeight="420"/>
                                    <TextBlock x:Name="PresetDescriptionLabel" Style="{StaticResource MutedTextStyle}" Margin="2,4,0,10"/>
                                    <WrapPanel>
                                        <Button x:Name="ApplyPresetButton" Content="APPLY PRESET" local:Loc.Localize="True" Style="{StaticResource AccentButtonStyle}" Click="ApplyPreset_Click" Margin="0,0,8,8"/>
                                        <Button Content="SAVE AS…" Click="SavePresetAs_Click" Margin="0,0,8,8" ToolTip="Store the current look as a user preset" local:Loc.Localize="True"/>
                                        <Button x:Name="DeletePresetButton" Content="DELETE" local:Loc.Localize="True" Style="{StaticResource DangerButtonStyle}" Click="DeletePreset_Click" Margin="0,0,8,8" IsEnabled="False"/>
                                        <Button Content="IMPORT…" Click="ImportPreset_Click" Margin="0,0,8,8" ToolTip="Load a preset .json file" local:Loc.Localize="True"/>
                                        <Button Content="EXPORT…" Click="ExportPreset_Click" Margin="0,0,8,8" ToolTip="Save the current look as a .json file" local:Loc.Localize="True"/>
                                        <Button Content="RESET TO DEFAULT" local:Loc.Localize="True" Style="{StaticResource GhostButtonStyle}" Click="ResetVisualSettings_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <TextBlock Text="SHARE CODE" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}" Margin="0,14,0,4"/>
                                    <TextBlock Text="Send the current look to somebody as text: copy it from the box, or paste a code you received and press APPLY CODE." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="ShareCodeBox" AutomationProperties.Name="Look share code" local:Loc.Localize="True" FontSize="10.5" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="74" VerticalScrollBarVisibility="Auto"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="COPY CODE" local:Loc.Localize="True" Click="CopyShareCode_Click" Margin="0,0,8,8" ToolTip="Put the current look in the box and on the clipboard"/>
                                        <Button Content="APPLY CODE" local:Loc.Localize="True" Style="{StaticResource AccentButtonStyle}" Click="ApplyShareCode_Click" Margin="0,0,8,8" ToolTip="Apply the code that is in the box"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ShareCodeStatusLabel" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,10"/>
                                    <StackPanel x:Name="StyleSettingsHost"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Theme" local:Loc.Localize="True" Tag="{StaticResource IconTheme}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ThemeSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Notes" local:Loc.Localize="True" Tag="{StaticResource IconNotes}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NoteSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Particles" local:Loc.Localize="True" Tag="{StaticResource IconParticles}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParticleSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Keyboard" local:Loc.Localize="True" Tag="{StaticResource IconKeyboard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="KeyboardSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Background" local:Loc.Localize="True" Tag="{StaticResource IconBackground}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SceneSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Camera &amp; FX" local:Loc.Localize="True" Tag="{StaticResource IconCamera}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CameraSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Audio" local:Loc.Localize="True" Tag="{StaticResource IconAudio}" local:SettingsPages.Section="SOUND &amp; INPUT">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="INSTRUMENT" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="Keyflow plays through a SoundFont (.sf2). The bundled concert grand loads automatically; load another file to change the sound." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,12"/>
                                    <Border Padding="14" CornerRadius="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="SoundFontLabel" Text="BUILT-IN GRAND · STARTING" local:Loc.Localize="True" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SoundFontHint" Text="Yamaha Disklavier grand piano" local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" FontSize="9.5" Margin="0,3,0,12"/>
                                            <WrapPanel>
                                                <Button x:Name="SoundFontButton" Content="◉  LOAD SOUNDFONT" local:Loc.Localize="True" Style="{StaticResource AccentButtonStyle}" Click="LoadSoundFont_Click" Margin="0,0,8,0"/>
                                                <Button Content="Unload · silent mode" local:Loc.Localize="True" Click="UnloadSoundFont_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="PRESET" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}"/>
                                    <ComboBox x:Name="PresetCombo" IsEnabled="False" SelectionChanged="PresetCombo_SelectionChanged" ToolTip="Choose an instrument preset from the loaded SoundFont" local:Loc.Localize="True"/>
                                    <TextBlock Text="EFFECTS" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}"/>
                                    <ToggleButton x:Name="ReverbToggle" Content="HALL REVERB" local:Loc.Localize="True" HorizontalAlignment="Left" Height="32" Style="{StaticResource PedalToggleStyle}" IsChecked="True" Checked="ReverbToggle_Changed" Unchecked="ReverbToggle_Changed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="MIDI" local:Loc.Localize="True" Tag="{StaticResource IconMidi}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="DEVICES" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="MIDI input" local:Loc.Localize="True" Style="{StaticResource LabelTextStyle}" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="InputDeviceCombo" AutomationProperties.Name="MIDI input device" local:Loc.Localize="True" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="InputDeviceCombo_SelectionChanged"/>
                                    <TextBlock Text="MIDI output" local:Loc.Localize="True" Style="{StaticResource LabelTextStyle}" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="OutputDeviceCombo" AutomationProperties.Name="MIDI output device" local:Loc.Localize="True" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="OutputDeviceCombo_SelectionChanged"/>
                                    <Button Content="⟳  Refresh devices" local:Loc.Localize="True" Click="RefreshDevices_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    <TextBlock Text="SONG TRACKS" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,4"/>
                                    <TextBlock Text="Solo a single track for practice, or mute tracks and recolor them for the video." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="TrackCombo" AutomationProperties.Name="MIDI track" local:Loc.Localize="True" SelectionChanged="TrackCombo_SelectionChanged"/>
                                    <StackPanel x:Name="TrackListHost" Margin="0,10,0,0"/>
                                    <TextBlock Text="METRONOME" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}"/>
                                    <CheckBox x:Name="MetronomeCheck" Content="SoundFont metronome click" local:Loc.Localize="True" IsEnabled="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Practice" local:Loc.Localize="True" Tag="{StaticResource IconPractice}" local:SettingsPages.Section="SESSION">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="PRACTICE MODE" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                                    <ComboBox x:Name="ModeCombo" AutomationProperties.Name="Practice mode" local:Loc.Localize="True" SelectedIndex="0" Margin="0,8,0,0" SelectionChanged="ModeCombo_SelectionChanged"><ComboBoxItem Content="Follow along" local:Loc.Localize="True"/><ComboBoxItem Content="Wait for my note" local:Loc.Localize="True"/><ComboBoxItem Content="Right hand only" local:Loc.Localize="True"/><ComboBoxItem Content="Left hand only" local:Loc.Localize="True"/></ComboBox>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Playback tempo" local:Loc.Localize="True" Style="{StaticResource LabelTextStyle}"/>
                                        <TextBlock x:Name="TempoLabel" Grid.Column="1" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="TempoSlider" Minimum="50" Maximum="150" Value="100" ValueChanged="TempoSlider_ValueChanged" AutomationProperties.Name="Playback tempo" local:Loc.Localize="True"/>
                                    <CheckBox x:Name="AutoPracticeTempoCheck" Content="Auto practice tempo" local:Loc.Localize="True" Margin="0,14,0,0" Checked="AutoPracticeTempo_Changed" Unchecked="AutoPracticeTempo_Changed" ToolTip="Slows the song down after repeated misses and speeds it back up as you play correctly"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Misses before slowing down" local:Loc.Localize="True" Style="{StaticResource LabelTextStyle}"/>
                                        <TextBlock x:Name="AutoPracticeMissLabel" Grid.Column="1" Text="3" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="AutoPracticeMissSlider" Minimum="1" Maximum="6" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="AutoPracticeMiss_Changed" AutomationProperties.Name="Misses before slowing down" local:Loc.Localize="True"/>
                                    <TextBlock Text="LOOP RANGE" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="A" Click="SetLoopA_Click" Width="40" ToolTip="Set the loop start at the playhead" local:Loc.Localize="True"/>
                                        <Button Content="B" Click="SetLoopB_Click" Width="40" Margin="6,0,0,0" ToolTip="Set the loop end at the playhead" local:Loc.Localize="True"/>
                                        <Button Content="×" Click="ClearLoop_Click" Width="40" Margin="6,0,0,0" ToolTip="Clear the loop" local:Loc.Localize="True"/>
                                        <TextBlock x:Name="LoopLabel" Text="No loop" local:Loc.Localize="True" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="SHORTCUTS" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Keys A W S E D F T G Y H U J K play an octave from C3 · Space play/pause · Escape settings · F11 full screen · click the on-screen keyboard to play with the mouse." local:Loc.Localize="True"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="History" local:Loc.Localize="True" Tag="{StaticResource IconPractice}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="PRACTICE HISTORY" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="Every finished run of the open song lands here: when it was played, its accuracy, the hits and the longest streak." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"/>
                                    <TextBlock Text="PRACTICE CHART" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="The last two weeks at a glance: one bar per day, taller when that day's notes landed better." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,6"/>
                                    <Canvas x:Name="HistoryChartHost" Height="52" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="HistoryChartLabel" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,12"/>
                                    <TextBlock Text="GHOST OF THIS SONG" local:Loc.Localize="True" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="HistoryGhostLabel" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,4"/>
                                    <StackPanel x:Name="HistoryGhostHost"/>
                                    <TextBlock x:Name="HistoryBestLabel" Style="{StaticResource LabelTextStyle}" Margin="0,12,0,6"/>
                                    <StackPanel x:Name="PracticeHistoryHost"/>
                                    <TextBlock x:Name="HistoryEmptyLabel" Text="Nothing recorded yet. Play a song through and its run will show up here." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"/>
                                    <TextBlock x:Name="HistorySummaryLabel" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="EXPORT HTML" local:Loc.Localize="True" Click="ExportHistory_Click" Margin="0,0,8,0"/>
                                        <Button Content="CLEAR HISTORY" local:Loc.Localize="True" Style="{StaticResource DangerButtonStyle}" Click="ClearHistory_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Recording" local:Loc.Localize="True" Tag="{StaticResource IconRecord}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,12,18,18">
                                    <TextBlock Text="VIDEO CAPTURE" local:Loc.Localize="True" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="Records the stage to an AVI file (MJPEG when a codec is available). Use the Green Screen preset and OBS for a keyed overlay." local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"/>
                                    <StackPanel x:Name="RecordingSettingsHost"/>
                                    <TextBlock x:Name="RecordingInfoLabel" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,10"/>
                                    <Button Content="●  START / STOP RECORDING" local:Loc.Localize="True" Style="{StaticResource DangerButtonStyle}" Click="RecordVideo_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="General" local:Loc.Localize="True" Tag="{StaticResource IconSliders}" local:SettingsPages.Section="APP">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GeneralSettingsHost" Margin="18,6,18,18"/></ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2" Padding="18,10" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsSaveLabel" Text="Changes apply live · saved automatically" local:Loc.Localize="True" Style="{StaticResource MutedTextStyle}" FontSize="9.5" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="RESET PAGE" Style="{StaticResource GhostButtonStyle}" Click="ResetPage_Click" Margin="0,0,6,0" ToolTip="Restore the current page to the active preset" local:Loc.Localize="True"/>
                                <Button Content="SAVE" local:Loc.Localize="True" Style="{StaticResource AccentButtonStyle}" Click="SaveVisualSettings_Click" Padding="16,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="LiveChromeOverlay" Panel.ZIndex="5" IsHitTestVisible="True">
                <Button x:Name="RecordButton" Content="REC" Tag="{StaticResource IconRecord}" Style="{StaticResource DangerIconButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,18,0,0" Padding="15,10" Click="RecordVideo_Click" ToolTip="Record the live piano visualizer" local:Loc.Localize="True"/>
                <Button x:Name="LiveSettingsButton" Content="MENU" Tag="{StaticResource IconMenu}" Style="{StaticResource IconTextButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,26,0" Padding="16,10" Click="Settings_Click" ToolTip="Show visual, audio, MIDI and practice settings (Escape)" local:Loc.Localize="True"/>
            </Grid>
