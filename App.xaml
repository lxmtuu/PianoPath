<Application x:Class="PianoPath.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PianoPath">
    <Application.Resources>
        <!-- ===== Palette ====================================================================
             Neutral, near-black surfaces with one violet→cyan accent: the same recipe the current
             generation of MIDI visualizers (Keysight, Piano VFX, Embers) uses, so the neon stage
             stays the brightest thing on screen instead of competing with the chrome. -->
        <Color x:Key="AccentColor">#8B5CFF</Color>
        <Color x:Key="AccentColor2">#25D0FF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CFF"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="#25D0FF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E8B5CFF"/>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C4DFF" Offset="0"/>
            <GradientStop Color="#B05CFF" Offset=".55"/>
            <GradientStop Color="#37C8FF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="WindowBrush" Color="#07070C"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F00F1017"/>
        <LinearGradientBrush x:Key="PanelChromeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F6171A25" Offset="0"/>
            <GradientStop Color="#EE0D0E15" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0D0E15"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#232633"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#15171F"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#1E2230"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#2B2F3E"/>
        <SolidColorBrush x:Key="PopupBrush" Color="#FA101219"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F3F8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9BA1B4"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="#666C80"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF4D6D"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#41E0A8"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#222533"/>
        <!-- Soft top highlight that gives every raised surface a lit edge, like a bevel in a 3D DCC. -->
        <LinearGradientBrush x:Key="TopSheenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1FFFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StageScrimBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C4050509" Offset="0"/>
            <GradientStop Color="#00050509" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="SoftShadow" Color="#000000" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity=".55"/>

        <!-- ===== Icons ======================================================================
             Plain geometry (no icon font, no external asset) so the chrome renders identically on
             every Windows install. -->
        <GeometryGroup x:Key="IconStyle">
            <RectangleGeometry Rect="3,13,3.4,7" RadiusX="1" RadiusY="1"/>
            <RectangleGeometry Rect="8.4,8,3.4,12" RadiusX="1" RadiusY="1"/>
            <RectangleGeometry Rect="13.8,4,3.4,16" RadiusX="1" RadiusY="1"/>
            <EllipseGeometry Center="20.4,7" RadiusX="1.7" RadiusY="1.7"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconNotes">
            <RectangleGeometry Rect="4,4,4,16" RadiusX="1.4" RadiusY="1.4"/>
            <RectangleGeometry Rect="10,9,4,11" RadiusX="1.4" RadiusY="1.4"/>
            <RectangleGeometry Rect="16,6,4,14" RadiusX="1.4" RadiusY="1.4"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconParticles">
            <EllipseGeometry Center="7,7" RadiusX="3" RadiusY="3"/>
            <EllipseGeometry Center="16,10" RadiusX="2" RadiusY="2"/>
            <EllipseGeometry Center="9,17" RadiusX="2.4" RadiusY="2.4"/>
            <EllipseGeometry Center="18,18" RadiusX="1.4" RadiusY="1.4"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconKeyboard" FillRule="EvenOdd">
            <RectangleGeometry Rect="2,6,20,13" RadiusX="2" RadiusY="2"/>
            <RectangleGeometry Rect="6,6,2.2,7.4"/>
            <RectangleGeometry Rect="11,6,2.2,7.4"/>
            <RectangleGeometry Rect="16,6,2.2,7.4"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconBackground" FillRule="EvenOdd">
            <RectangleGeometry Rect="2.5,4.5,19,15" RadiusX="2" RadiusY="2"/>
            <EllipseGeometry Center="8.5,10" RadiusX="2.2" RadiusY="2.2"/>
            <RectangleGeometry Rect="5,15.5,6,3"/>
            <RectangleGeometry Rect="12,13.5,7,5"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconCamera" FillRule="EvenOdd">
            <RectangleGeometry Rect="2,7,20,12" RadiusX="2.4" RadiusY="2.4"/>
            <EllipseGeometry Center="12,13" RadiusX="4" RadiusY="4"/>
            <RectangleGeometry Rect="8,4,8,3" RadiusX="1" RadiusY="1"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconAudio">
            <RectangleGeometry Rect="3,9,4,6" RadiusX="1" RadiusY="1"/>
            <RectangleGeometry Rect="7,6,4,12" RadiusX="1" RadiusY="1"/>
            <EllipseGeometry Center="16,12" RadiusX="2" RadiusY="4.4"/>
            <EllipseGeometry Center="20,12" RadiusX="1.6" RadiusY="6.4"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconMidi" FillRule="EvenOdd">
            <RectangleGeometry Rect="3,8,7,8" RadiusX="1.6" RadiusY="1.6"/>
            <RectangleGeometry Rect="14,8,7,8" RadiusX="1.6" RadiusY="1.6"/>
            <RectangleGeometry Rect="9.4,11,5.2,2"/>
            <EllipseGeometry Center="6.5,12" RadiusX="1.1" RadiusY="1.1"/>
            <EllipseGeometry Center="17.5,12" RadiusX="1.1" RadiusY="1.1"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconPractice" FillRule="EvenOdd">
            <EllipseGeometry Center="12,12" RadiusX="8.6" RadiusY="8.6"/>
            <EllipseGeometry Center="12,12" RadiusX="4.4" RadiusY="4.4"/>
            <EllipseGeometry Center="12,12" RadiusX="1.4" RadiusY="1.4"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconRecord">
            <EllipseGeometry Center="12,12" RadiusX="7.4" RadiusY="7.4"/>
        </GeometryGroup>
        <PathGeometry x:Key="IconPlay" Figures="M 7,4.4 L 19.6,12 L 7,19.6 Z"/>
        <GeometryGroup x:Key="IconPause">
            <RectangleGeometry Rect="6.6,4.6,4,14.8" RadiusX="1.2" RadiusY="1.2"/>
            <RectangleGeometry Rect="13.4,4.6,4,14.8" RadiusX="1.2" RadiusY="1.2"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconRestart">
            <RectangleGeometry Rect="4.6,4.6,2.4,14.8" RadiusX="1" RadiusY="1"/>
            <PathGeometry Figures="M 20,4.8 L 9.6,12 L 20,19.2 Z"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconMenu">
            <RectangleGeometry Rect="3,5.6,18,2.4" RadiusX="1.2" RadiusY="1.2"/>
            <RectangleGeometry Rect="3,10.8,18,2.4" RadiusX="1.2" RadiusY="1.2"/>
            <RectangleGeometry Rect="3,16,18,2.4" RadiusX="1.2" RadiusY="1.2"/>
        </GeometryGroup>
        <PathGeometry x:Key="IconFolder" Figures="M 2.6,6.4 L 9.2,6.4 L 11.4,8.8 L 21.4,8.8 L 21.4,18.6 L 2.6,18.6 Z"/>
        <PathGeometry x:Key="IconClose" Figures="M 5.6,5.6 L 18.4,18.4 M 18.4,5.6 L 5.6,18.4"/>
        <PathGeometry x:Key="IconMinimize" Figures="M 5.4,12 L 18.6,12"/>
        <PathGeometry x:Key="IconMaximize" Figures="M 5.4,5.4 L 18.6,5.4 L 18.6,18.6 L 5.4,18.6 Z"/>
        <GeometryGroup x:Key="IconSearch">
            <EllipseGeometry Center="10.4,10.4" RadiusX="5.6" RadiusY="5.6"/>
            <RectangleGeometry Rect="14.4,13.6,6,2" RadiusX="1" RadiusY="1"/>
        </GeometryGroup>
        <PathGeometry x:Key="IconChevronDown" Figures="M 5,8.6 L 12,15.4 L 19,8.6 L 17.2,6.8 L 12,11.9 L 6.8,6.8 Z"/>
        <GeometryGroup x:Key="IconHome">
            <PathGeometry Figures="M 12,3.6 L 21,11 L 18.6,11 L 18.6,20 L 13.6,20 L 13.6,14.4 L 10.4,14.4 L 10.4,20 L 5.4,20 L 5.4,11 L 3,11 Z"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconInfo">
            <EllipseGeometry Center="12,5.4" RadiusX="1.9" RadiusY="1.9"/>
            <RectangleGeometry Rect="10.4,9.2,3.2,10.4" RadiusX="1.4" RadiusY="1.4"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconSliders" FillRule="EvenOdd">
            <RectangleGeometry Rect="3,6.1,18,2" RadiusX="1" RadiusY="1"/>
            <EllipseGeometry Center="8.6,7.1" RadiusX="2.5" RadiusY="2.5"/>
            <RectangleGeometry Rect="3,11,18,2" RadiusX="1" RadiusY="1"/>
            <EllipseGeometry Center="15.4,12" RadiusX="2.5" RadiusY="2.5"/>
            <RectangleGeometry Rect="3,15.9,18,2" RadiusX="1" RadiusY="1"/>
            <EllipseGeometry Center="11,16.9" RadiusX="2.5" RadiusY="2.5"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconLogo">
            <RectangleGeometry Rect="1.5,4,21,16" RadiusX="3" RadiusY="3"/>
            <RectangleGeometry Rect="6.4,4,2.4,9.4"/>
            <RectangleGeometry Rect="11.8,4,2.4,9.4"/>
            <RectangleGeometry Rect="17.2,4,2.4,9.4"/>
            <EllipseGeometry Center="12,17" RadiusX="1.5" RadiusY="1.5"/>
        </GeometryGroup>


        <!-- ===== Text ===== -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===== ToolTip ===== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource PopupBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <Grid>
                                <Border x:Name="Sheen" CornerRadius="8" Background="{StaticResource TopSheenBrush}" Opacity=".55" IsHitTestVisible="False" VerticalAlignment="Top" Height="11" Margin="1,1,1,0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                <Setter TargetName="Sheen" Property="Opacity" Value=".9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Sheen" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>
        <Style x:Key="MenuPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="MenuCardButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="MenuLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3A1420"/>
            <Setter Property="BorderBrush" Value="#7A2A44"/>
            <Setter Property="Foreground" Value="#FFB3C4"/>
        </Style>
        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <!-- Icon buttons: the glyph comes from Tag so one style serves the whole chrome. -->
        <Style x:Key="GlyphButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Path x:Name="Glyph" Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Window caption controls: flat, no border, red on close. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource GlyphButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8">
                            <Path x:Name="Glyph" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8">
                            <Path x:Name="Glyph" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E8113B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Labelled button with a leading icon. -->
        <Style x:Key="IconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <Grid>
                                <Border x:Name="Sheen" CornerRadius="8" Background="{StaticResource TopSheenBrush}" Opacity=".5" IsHitTestVisible="False" VerticalAlignment="Top" Height="11" Margin="1,1,1,0"/>
                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="Glyph" Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                <Setter TargetName="Sheen" Property="Opacity" Value=".85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Sheen" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconTextButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Round transport button; the play/pause glyph is swapped through Tag. -->
        <Style x:Key="RoundGlyphButtonStyle" TargetType="Button" BasedOn="{StaticResource GlyphButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Chrome" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            <Path x:Name="Glyph" Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Stroke" Value="#8CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Stroke" Value="#B3FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportPlayStyle" TargetType="Button" BasedOn="{StaticResource RoundGlyphButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconTextButtonStyle}">
            <Setter Property="Background" Value="#33131F"/>
            <Setter Property="BorderBrush" Value="#7C2A44"/>
            <Setter Property="Foreground" Value="#FFB3C4"/>
        </Style>

        <!-- Search field with room for the leading magnifier. -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="28,4,8,4"/>
        </Style>

        <!-- Raised chrome panel: layered surface, hairline top edge and a soft drop shadow. -->
        <Style x:Key="PanelChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelChromeBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>
        <!-- Read-out chip used by the transport bar for accuracy, score and streak. -->
        <Style x:Key="StatChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#0E1017"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Toggle buttons (pedals, pills) ===== -->
        <Style x:Key="PedalToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#3F3A55" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Switch (CheckBox) ===== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0" RecognizesAccessKey="True"/>
                            <Border x:Name="Track" Grid.Column="1" Width="34" Height="18" CornerRadius="9" Background="{StaticResource TrackBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#8F86A8" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#66FFFFFF"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <!-- ===== Slider ===== -->
        <Style x:Key="SliderFillButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Halo" Fill="{StaticResource AccentSoftBrush}" Margin="-5" Opacity="0"/>
                            <Ellipse x:Name="Knob" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" VerticalAlignment="Center" Height="22">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox ===== -->
        <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0,28,0"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboToggleStyle}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"/>
                                    <ScrollViewer Margin="3,8,3,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ScrollBar ===== -->
        <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="#4D8F86A8" CornerRadius="3" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== ProgressBar ===== -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="{StaticResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Settings navigation (TabControl) ===== -->
        <Style x:Key="SettingsNavItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="9" Margin="8,2" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}" Fill="{StaticResource DimTextBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Left" Margin="-11,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover first, selection second: in WPF the later trigger wins, so a selected page keeps its accent. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{StaticResource MutedTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Accent2Brush}"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="164"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,10,0,14">
                                        <TextBlock Text="STAGE DESIGN" Style="{StaticResource EyebrowTextStyle}" Margin="20,4,0,10"/>
                                        <TabPanel IsItemsHost="True"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="1" Background="Transparent">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Preset list ===== -->
        <Style x:Key="PresetListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
